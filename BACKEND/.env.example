# ============================================================
# TourManager - Variables de entorno (EJEMPLO)
# Copie este archivo como .env y complete los valores reales.
# Nunca suba el archivo .env al repositorio.
# ============================================================

# --- Servidor ---
NODE_ENV=development
PUERTO=3000

# --- Base de datos MySQL ---
BD_HOST=localhost
BD_PUERTO=3306
BD_USUARIO=usuario_bd
BD_CLAVE=clave_bd
BD_NOMBRE=tourmanager
BD_POOL_MAX=10
BD_POOL_MIN=0

# --- JWT ---
JWT_CLAVE=coloque_aqui_una_clave_larga_y_aleatoria
JWT_EXPIRACION=8h

# --- CORS (lista separada por comas) ---
CORS_ORIGENES=http://localhost:5500,http://127.0.0.1:5500

# --- Registros (logs) ---
LOG_NIVEL=info
